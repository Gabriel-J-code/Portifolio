# Copie este arquivo para ".env" e preencha os valores.
# O .env NAO vai para o Git (esta no .gitignore).
# Senha do SQL Server: 8+ caracteres com maiuscula, minuscula, numero e simbolo. Evite "$".
DB_PASSWORD=TroqueEstaSenha123!

# Senha do usuario 'admin' (HTTP Basic temporario, ate existir o login com JWT)
ADMIN_PASSWORD=TroqueEstaSenhaTambem

# E-mail da conta do painel (criada na 1a inicializacao) e destino do codigo 2FA.
# Em desenvolvimento qualquer endereco serve: o Mailpit captura tudo (http://localhost:8025).
ADMIN_EMAIL=seu-email@exemplo.com

# Chave que assina os tokens JWT: 32 bytes aleatorios em Base64. Quem tiver a chave consegue forjar tokens!
# Gerar (PowerShell): $b=[byte[]]::new(32); [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
# Gerar (Linux/macOS): openssl rand -base64 32
JWT_SECRET=GereUmaChaveNovaComOComandoAcima
